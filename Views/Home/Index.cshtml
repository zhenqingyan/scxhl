@{
    ViewData["Title"] = "首页";
}

<div id="home-app" style="display:flex;justify-content:center;align-items:center;min-height:calc(100vh - 104px)">
    <t-card
        :bordered="false"
        style="max-width:480px;width:100%;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,0.08);border-radius:16px;padding:32px 24px"
    >
        <div style="margin-bottom:16px">
            <t-tag theme="primary" variant="light" size="large">扫码联系我们</t-tag>
        </div>
        <img
            src="https://henglong.oss-cn-shanghai.aliyuncs.com/erweima.jpg"
            alt="联系二维码"
            style="max-width:280px;width:100%;border-radius:12px;box-shadow:0 2px 16px rgba(0,82,217,0.12)"
        />
        <div style="margin-top:20px;color:#666;font-size:14px">
            扫描二维码，了解更多面料产品信息
        </div>
        <div style="margin-top:16px">
            <t-space>
                <t-button theme="primary" variant="outline" href="/Product">
                    <template #icon><t-icon name="view-list" /></template>
                    浏览产品目录
                </t-button>
                <t-button theme="primary" href="/Order">
                    <template #icon><t-icon name="cart" /></template>
                    查看订单
                </t-button>
            </t-space>
        </div>
    </t-card>
</div>

@@section Scripts {
    <script>
        const homeApp = Vue.createApp({});
        homeApp.use(TDesign);
        homeApp.mount('#home-app');
    </script>
}
