<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 恒隆面料管理系统</title>
    <!-- TDesign Vue3 -->
    <link rel="stylesheet" href="~/lib/tdesign/tdesign.min.css" />
    <!-- Axios -->
    <script src="~/lib/axios/dist/axios.min.js"></script>
    <!-- Vue 3 -->
    <script src="~/lib/vue/vue.global.prod.js"></script>
    <!-- TDesign Vue Next -->
    <script src="~/lib/tdesign/tdesign.min.js"></script>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f6fa; }
        .app-header {
            background: linear-gradient(135deg, #0052d9 0%, #1677ff 100%);
            height: 56px;
            display: flex;
            align-items: center;
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 8px rgba(0,82,217,0.2);
        }
        .app-header-logo {
            font-size: 18px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 1px;
        }
        .app-header-nav {
            display: flex;
            gap: 8px;
            margin-left: 32px;
        }
        .app-header-nav a {
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.2s;
        }
        .app-header-nav a:hover,
        .app-header-nav a.active {
            background: rgba(255,255,255,0.18);
            color: #fff;
        }
        .app-main {
            min-height: calc(100vh - 56px);
            padding: 24px;
        }
        .app-header-actions {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .logout-button {
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 6px;
            background: transparent;
            color: #fff;
            cursor: pointer;
            font: inherit;
            font-size: 14px;
            line-height: 20px;
            padding: 5px 13px;
        }
        .logout-button:hover {
            background: rgba(255,255,255,0.18);
        }
        .reset-field {
            margin-bottom: 14px;
        }
        .reset-field label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            color: #4e5969;
        }
    </style>
</head>
<body>
    <header class="app-header">
        <span class="app-header-logo">🧵 恒隆面料管理系统</span>
        <nav class="app-header-nav">
            <a href="/" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">首页</a>
            <a href="/Product" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">产品管理</a>
            <a href="/Order" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">订单管理</a>
        </nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            var isSuperAdmin = User.FindFirst(henglong.Web.Models.AdminClaimTypes.AdminType)?.Value == henglong.Web.Models.AdminIdentityTypes.Super;
            <div class="app-header-actions">
                @if (isSuperAdmin)
                {
                    <div id="admin-layout-app" data-super-admin="true">
                        <t-button theme="default" variant="outline" @@click="openReset">
                            <template #icon><t-icon name="setting" /></template>
                            重置管理员密码
                        </t-button>
                        <t-dialog
                            v-model:visible="resetVisible"
                            header="重置数据库管理员密码"
                            :confirm-btn="{ content: '确认', theme: 'primary', loading: saving }"
                            :cancel-btn="{ content: '取消' }"
                            @@confirm="submitReset"
                        >
                            <div class="reset-field">
                                <label>管理员用户名</label>
                                <t-input v-model="form.username" placeholder="请输入数据库管理员用户名" />
                            </div>
                            <div class="reset-field">
                                <label>新密码</label>
                                <t-input v-model="form.newPassword" type="password" placeholder="请输入新密码" />
                            </div>
                        </t-dialog>
                    </div>
                }
                <form method="post" action="/Account/Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-button">退出登录</button>
                </form>
            </div>
        }
    </header>
    <main class="app-main">
        @RenderBody()
    </main>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/admin-layout.js"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
