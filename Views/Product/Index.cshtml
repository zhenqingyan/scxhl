@{
    ViewData["Title"] = "产品管理";
}

<div id="app">
    <!-- 顶部工具栏 -->
    <t-card :bordered="false" style="margin-bottom:16px">
        <t-row :gutter="16" align="middle">
            <t-col :span="12">
                <t-space>
                    <t-upload
                        :action="uploadUrl"
                        accept=".jpg,.jpeg,.png,.webp"
                        :multiple="true"
                        :show-upload-progress="true"
                        theme="file-input"
                        @@success="onUploadSuccess"
                        @@fail="onUploadFail"
                    >
                        <t-button variant="outline" theme="primary">
                            <template #icon><t-icon name="upload" /></template>
                            上传图片
                        </t-button>
                    </t-upload>
                    <t-button theme="primary" @@click="queryData" :loading="loading">
                        <template #icon><t-icon name="refresh" /></template>
                        刷新列表
                    </t-button>
                </t-space>
            </t-col>
            <t-col :span="12" style="text-align:right">
                <span style="color:#999;font-size:13px">共 {{ pageData.total }} 条记录</span>
            </t-col>
        </t-row>
    </t-card>

    <!-- 分页（上方） -->
    <t-card :bordered="false" style="margin-bottom:16px" v-if="pageData.total > 0">
        <t-row justify="center">
            <t-pagination
                v-model="pageData.current"
                :total="pageData.total"
                :page-size="pageData.pageSize"
                :page-size-options="[9, 18, 27]"
                show-jumper
                @@change="onPageChange"
            />
        </t-row>
    </t-card>

    <!-- 产品卡片列表 -->
    <div v-if="loading" style="text-align:center;padding:60px 0">
        <t-loading size="large" text="加载中..." />
    </div>

    <div v-else-if="tableData.length === 0" style="text-align:center;padding:60px 0">
        <t-icon name="inbox" size="48px" style="color:#ccc" />
        <p style="color:#999;margin-top:12px">暂无产品数据</p>
    </div>

    <t-row v-else :gutter="[16,16]">
        <t-col
            v-for="item in tableData"
            :key="item.guid"
            :xs="12" :sm="6" :md="3" :lg="3" :xl="3"
        >
            <t-card
                :bordered="true"
                hover-shadow
                class="product-card"
                style="height:100%"
            >
                <!-- 卡片标题 -->
                <template #title>
                    <div class="card-title-row">
                        <t-tooltip :content="item.name" placement="top">
                            <span class="card-title-text">{{ item.name }}</span>
                        </t-tooltip>
                    </div>
                </template>
                <template #actions>
                    <t-space :size="12">
                        <t-tooltip content="编辑属性">
                            <t-button
                                variant="outline"
                                theme="primary"
                                size="medium"
                                @@click="openEditDialog(item)"
                            >
                                <template #icon><t-icon name="edit" /></template>
                                编辑
                            </t-button>
                        </t-tooltip>
                        <t-tooltip content="删除">
                            <t-popconfirm
                                content="确认删除该产品吗？"
                                theme="danger"
                                @@confirm="delData(item)"
                            >
                                <t-button
                                    variant="outline"
                                    theme="danger"
                                    size="medium"
                                >
                                    <template #icon><t-icon name="delete" /></template>
                                    删除
                                </t-button>
                            </t-popconfirm>
                        </t-tooltip>
                        <t-switch
                            v-model="item.status"
                            size="large"
                            @@change="changeStatus($event, item)"
                        />
                    </t-space>
                </template>

                <!-- 产品图片 -->
                <div class="product-img-wrap">
                    <t-image
                        :src="'https://henglong.oss-cn-shanghai.aliyuncs.com/' + item.guid"
                        :style="{ width: '100%', height: '300px' }"
                        fit="contain"
                        :lazy="true"
                    >
                        <template #error>
                            <div class="img-error">
                                <t-icon name="image" size="32px" />
                                <span>图片加载失败</span>
                            </div>
                        </template>
                    </t-image>
                </div>

                <!-- 属性展示 -->
                <div class="item-props-display" style="margin-top:12px">
                    <t-row :gutter="8">
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">排序</div>
                                <div class="prop-value">{{ item.level }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">编号</div>
                                <div class="prop-value">{{ item.number || '-' }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">成份</div>
                                <div class="prop-value">{{ item.composition || '-' }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">纱支</div>
                                <div class="prop-value">{{ item.yarnCount || '-' }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">密度</div>
                                <div class="prop-value">{{ item.density || '-' }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">克重</div>
                                <div class="prop-value">{{ item.gramWeight || '-' }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">门幅</div>
                                <div class="prop-value">{{ item.doorframe || '-' }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">宽</div>
                                <div class="prop-value">{{ item.width }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">高</div>
                                <div class="prop-value">{{ item.height }}</div>
                            </div>
                        </t-col>
                        <t-col :span="6">
                            <div class="prop-display-item">
                                <div class="prop-label">比例</div>
                                <div class="prop-value">{{ item.percent }}</div>
                            </div>
                        </t-col>
                    </t-row>
                </div>

                <!-- 底部信息 -->
                <t-divider style="margin:8px 0" />
                <div class="card-footer">
                    <t-tag
                        v-if="item.status"
                        theme="success"
                        variant="light"
                        size="small"
                    >已启用</t-tag>
                    <t-tag
                        v-else
                        theme="default"
                        variant="light"
                        size="small"
                    >已禁用</t-tag>
                    <span class="card-time">{{ formatTime(item.createTime) }}</span>
                </div>
            </t-card>
        </t-col>
    </t-row>

    <!-- 编辑对话框 -->
    <t-dialog
        v-model:visible="editDialogVisible"
        header="编辑产品属性"
        width="620px"
        :confirm-btn="{ content: '确认', theme: 'primary', loading: editSaving }"
        :cancel-btn="{ content: '取消' }"
        @@confirm="saveEdit"
        @@close="editDialogVisible = false"
    >
        <t-row :gutter="[16,12]">
            <t-col :span="4" v-for="f in editFields" :key="f.key">
                <div class="edit-field">
                    <label class="edit-label">{{ f.label }}</label>
                    <t-input
                        v-model="editForm[f.key]"
                        :type="f.type === 'number' ? 'number' : 'text'"
                        :disabled="f.readonly"
                        :placeholder="f.label"
                        size="medium"
                    />
                </div>
            </t-col>
        </t-row>
    </t-dialog>

    <!-- 底部分页 -->
    <t-card :bordered="false" style="margin-top:16px" v-if="tableData.length > 0 && pageData.total > pageData.pageSize">
        <t-row justify="center">
            <t-pagination
                v-model="pageData.current"
                :total="pageData.total"
                :page-size="pageData.pageSize"
                :page-size-options="[9, 18, 27]"
                show-jumper
                @@change="onPageChange"
            />
        </t-row>
    </t-card>
</div>

<style>
.product-card {
    transition: box-shadow 0.2s;
}
.card-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 120px;
}
.card-title-text {
    font-size: 12px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #1a1a1a;
}
.product-img-wrap {
    width: 100%;
    background: #f8f9fb;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid #f0f0f0;
}
.img-error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 280px;
    color: #bbb;
    gap: 8px;
    font-size: 12px;
}
.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.card-time {
    font-size: 11px;
    color: #999;
}
/* 属性展示区域 */
.item-props-display {
    background: #f5f6fa;
    border-radius: 6px;
    padding: 12px;
}
.prop-display-item {
    margin-bottom: 8px;
}
.prop-label {
    font-size: 11px;
    color: #999;
    margin-bottom: 2px;
}
.prop-value {
    font-size: 13px;
    color: #333;
    font-weight: 500;
}
/* 编辑对话框 */
.edit-field {
    margin-bottom: 4px;
}
.edit-label {
    display: block;
    font-size: 12px;
    color: #666;
    margin-bottom: 4px;
}
</style>

@@section Scripts {
    <script src="~/js/product.js"></script>
}
